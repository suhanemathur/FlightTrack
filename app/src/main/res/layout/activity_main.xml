<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Welcome Message -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome!"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"/>

    <!-- Weather Information -->
    <TextView
        android:id="@+id/tvWeather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Weather info here"
        android:textSize="16sp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"/>

    <!-- Starting Point Display -->
    <TextView
        android:id="@+id/tvStartingPoint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Starting Point: Not Set"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"/>

    <!-- Progress Bar Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@android:drawable/progress_horizontal"/>

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Covered: 0 km | Left: 0 km"
            android:textSize="16sp"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- RecyclerView for Stops -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"/>

    <!-- Fact Box for Stops -->
    <TextView
        android:id="@+id/tvFact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fact about the place will appear here"
        android:textSize="16sp"
        android:padding="10dp"
        android:background="#FFF9C4"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>



    <!-- Buttons Container -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnToggleDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toggle Distance"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnNextStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next Stop"/>
    </LinearLayout>

    <!-- Restart Button -->
    <Button
        android:id="@+id/btnRestart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Restart Journey"
        android:layout_marginTop="12dp"
        android:visibility="visible"/>

</LinearLayout>
